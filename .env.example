# JK reads only these three variables. Copy this file to .env at the root of
# the checkout and fill in real values; keep .env readable only by its owner
# (chmod 600 .env). A variable already set in the process environment wins
# over the value in .env. README, "Configure", says the rest.

# Base URL of the Jenkins controller JK talks to; a trailing slash is fine.
JENKINS_URL=https://jenkins.ci.folio.org

# Jenkins user the panel acts as.
JENKINS_USER_ID=your-jenkins-user-id

# API token for that user, from the Jenkins user page ("Security", "API Token").
# Sent as Basic-auth password over HTTPS; TLS verification is never disabled.
JENKINS_API_TOKEN=your-api-token
